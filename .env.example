# Copy this file to .env and fill in the values before running the server.
# Never commit .env to git.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Path to the data volume (job files and SQLite DB)
IMMUNOLYSER_DATA=/pvol

# Set to 'true' if running inside Docker, 'false' on bare server
IS_DOCKER=false

# Set to 'true' only for local development — NEVER in production
DEBUG=False

# Sender address for job notification emails (uses Monash SMTP relay, no password needed)
EMAIL_ADDRESS=noreply@immunolyser.erc.monash.edu

# Public base URL of the server (used in email links)
BASE_URL=https://immunolyser.erc.monash.edu
# Session cookie is Secure by default; only set false for plain-http dev on a non-localhost host
# SESSION_COOKIE_SECURE=false

# UUID of the demo job shown on the homepage
DEMO_TASK_ID=

# Days before job files are deleted from the server (default: 30)
DATA_RETENTION_DAYS=30

# Google reCAPTCHA v3 — get keys from https://www.google.com/recaptcha/admin
# Leave blank to disable CAPTCHA (e.g. local development)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Comma-separated emails allowed to submit jobs with an extended (~20h) processing
# time limit, for datasets too large to finish within the default limit. Keep this
# list secret — do not commit real values, do not expose it anywhere in the UI.
# Matched against the email entered on the job confirmation page.
LONG_JOB_ALLOWED_EMAILS=

# Seconds a submitted job waits for an allowlisted email before dispatching with
# the default (non-extended) time limit anyway. (default: 90)
PENDING_DISPATCH_GRACE_SECONDS=90

# Per-sample peptide count above which the submission form shows a non-blocking
# "this may take a while" heads-up. Does not prevent submission. (default: 10000)
PEPTIDE_WARNING_THRESHOLD=10000

# --- docker-compose only (host paths, not read by the app itself) ---
# Where job files + SQLite DB live on the HOST. Leave unset for a local
# install (defaults to ./data next to docker-compose.yml); set to a
# persistent path (e.g. /pvol) for a server deployment.
DATA_VOLUME=
# Where HLA-PepClust (MHC-TP) reference data + warmed numba cache live on
# the HOST. Leave unset for a local install (defaults to
# ./hla-pepclust-ref-data); set to a persistent path for a server
# deployment — see app/tools/README.md.
HLA_PEPCLUST_REF_DATA=
